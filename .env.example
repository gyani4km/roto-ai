# ROTO settings. Setup copies this file to .env. Put your keys in .env only (it is gitignored, never commit it).
# Lines starting with # are comments. Use forward slashes in paths. A blank key turns that feature off.
# Process environment variables win over this file. Restart ROTO after editing.

# ---- Language model (answers). Groq, OpenAI-compatible. Get a key: https://console.groq.com/keys
# Blank key = built-in demo answers (shown with a "Demo" badge).
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_S=15

# ---- Text-to-speech (the voice). Google Cloud Text-to-Speech API key.
# Get one: https://console.cloud.google.com/apis/credentials (enable "Cloud Text-to-Speech API" first).
# Blank key = captions only, no voice.
TTS_PROVIDER=google
GOOGLE_TTS_API_KEY=
TTS_TIMEOUT_S=15
# One voice per language. Defaults are Chirp3-HD (most natural). Neural2/Standard voices answer about 0.5 s faster
# (en-IN-Neural2-B, hi-IN-Neural2-B; Telugu has Standard only). Voices can also be chosen in the console (Voice tab).
# TTS_VOICE_EN=en-IN-Chirp3-HD-Charon
# TTS_VOICE_TE=te-IN-Chirp3-HD-Charon
# TTS_VOICE_HI=hi-IN-Chirp3-HD-Charon

# ---- Speech-to-text (the microphone). Sarvam AI. Get a key: https://dashboard.sarvam.ai/
# The language (English, Telugu, Hindi) is detected automatically. Blank key = typed questions only.
STT_PROVIDER=sarvam
SARVAM_API_KEY=
STT_MODEL=saarika:v2.5
STT_TIMEOUT_S=20

# ---- Behaviour
# Open the cloud connections at server start so the first answer is fast. Set to 0 to skip.
ROTO_PRELOAD=1
# Seconds between idle keep-alive pings that keep those connections warm.
ROTO_KEEPALIVE_S=40

# ---- Character file (advanced)
# Normally leave blank: the character file goes at assets/character.glb (see README) and is checked against the
# SHA-256 pin in config/avatar-lock.json. Set a path here only to use a different file (no checksum pin).
ROTO_MODEL_PATH=
